#!/bin/sh
# ==============================================================================
# Dependency installation - chezmoi run_onchange script
# ==============================================================================
# Runs during chezmoi apply, but only again when the content changes.
# The content embeds two hashes, so:
#   - The first install runs it
#   - Selected options changed (dotgraft reconfigure): rerun
#   - Brewfile changed: rerun
#   - Nothing changed: skip silently without slowing down every apply
#
# Note: run_onchange is not convergence. If a package is removed manually or
# install failed, unchanged script content means no rerun. So dotgraft has
# `dotgraft deps`, which always reruns this script. On failure this script
# exits nonzero so chezmoi does not mark this version complete and retries on
# the next apply.
#
# The script must be idempotent: brew skips packages that are already installed.
# ==============================================================================
set -eu

# Choices hash: {{ .tools | toJson | sha256sum }}
# Manifest hash: {{ include "Brewfile" | sha256sum }}

# Embedded copy of scripts/lib/language.sh so this standalone script can choose
# its UI language at runtime. Language is never decided at template render time:
# changing the shell locale must not change this script's content or rerun it.
# Compatible with POSIX sh and macOS Bash 3.2.

# Return en/zh for supported locale names; return nothing for unknown names.
dotgraft_locale_language() {
  case "$1" in
    zh | zh_* | zh-* | Chinese*) printf 'zh\n' ;;
    en | en_* | en-* | English*) printf 'en\n' ;;
  esac
}

# Explicit overrides win, followed by locale variables and macOS preferences.
# Do not change LC_ALL/LANG: external tools retain their own locale behavior.
dotgraft_detect_language() {
  if [ -n "${DOTGRAFT_LANG:-}" ]; then
    case "$DOTGRAFT_LANG" in
      en | zh) printf '%s\n' "$DOTGRAFT_LANG" ;;
      *) printf 'en\n' ;;
    esac
    return
  fi

  # The first populated locale is authoritative. An unsupported locale falls
  # back to English rather than a lower-priority, potentially stale variable.
  dotgraft_locale="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
  case "$dotgraft_locale" in
    '' | C | POSIX | C.UTF-8 | C.utf8) ;;
    *)
      dotgraft_language="$(dotgraft_locale_language "$dotgraft_locale")"
      printf '%s\n' "${dotgraft_language:-en}"
      return
      ;;
  esac

  # macOS shells may expose no meaningful locale. Read only the first preferred
  # UI language; a secondary Chinese language must not override the primary one.
  if command -v defaults > /dev/null 2>&1; then
    dotgraft_preferred="$({ defaults read -g AppleLanguages 2> /dev/null || true; } | awk '
      /\(/ { next }
      { gsub(/[",[:space:]]/, ""); if (length && $0 != ")") { print; exit } }
    ')"
    dotgraft_language="$(dotgraft_locale_language "$dotgraft_preferred")"
    printf '%s\n' "${dotgraft_language:-en}"
  else
    printf 'en\n'
  fi
}

# Resolve the UI language once at runtime, not while chezmoi renders template.
DOTGRAFT_UI_LANG="$(dotgraft_detect_language)"

# Print the English or Chinese template for the current UI language.
dg_text() {
  dg_en="$1"
  dg_zh="$2"
  shift 2
  if [ "$DOTGRAFT_UI_LANG" = "zh" ]; then
    # shellcheck disable=SC2059
    printf "$dg_zh" "$@"
  else
    # shellcheck disable=SC2059
    printf "$dg_en" "$@"
  fi
}

if ! command -v brew > /dev/null 2>&1; then
  dg_text '  ! Homebrew not found; cannot install dependencies\n' \
    '  ! 找不到 Homebrew，无法安装依赖\n' >&2
  dg_text '    Install Homebrew, then run dotgraft deps to retry\n' \
    '    装好 Homebrew 后运行 dotgraft deps 重试\n' >&2
  exit 1
fi

failed=0

dg_text '==> Installing base dependencies\n' '==> 安装基础依赖\n'
# A single package failure (such as a network issue) should not stop the rest,
# but the failure must be reflected in the exit code; otherwise chezmoi assumes
# dependencies are installed.
brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile" || failed=1

# ------------------------------------------------------------------------------
# Fonts: install only when missing
# ------------------------------------------------------------------------------
# The font cask tries to "adopt" an existing file and exits on different
# binaries:
#   "It seems the existing Font is different from the one being installed."
# Anyone who installed Maple Mono manually from GitHub will almost certainly hit
# it. So probe first and skip entirely when the font already exists.
#
# Match CN only: matching just "maple" would treat non-CN Maple Mono NF as
# installed while the config names Maple Mono NF CN, leading to font fallback.
if ls "$HOME/Library/Fonts" /Library/Fonts 2> /dev/null | grep -Eqi 'maple.*cn'; then
  dg_text '==> Maple Mono NF CN font already exists; skipping\n' \
    '==> 已存在 Maple Mono NF CN 字体，跳过\n'
else
  dg_text '==> Installing font font-maple-mono-nf-cn\n' \
    '==> 安装字体 font-maple-mono-nf-cn\n'
  brew install --cask font-maple-mono-nf-cn || failed=1
fi

# ------------------------------------------------------------------------------
# Optional CLI tools
# ------------------------------------------------------------------------------
{{ if .tools -}}
dg_text '==> Installing optional tools: %s\n' \
  '==> 安装选配工具: %s\n' "{{ .tools | join " " }}"
brew install {{ .tools | join " " }} || failed=1
{{- else -}}
dg_text '==> No optional CLI tools selected; skipping\n' \
  '==> 没有选择任何 CLI 工具，跳过\n'
{{- end }}

if [ "$failed" -ne 0 ]; then
  dg_text '\n' '\n' >&2
  dg_text '  ! Some dependencies were not installed\n' \
    '  ! 有依赖没装上\n' >&2
  dg_text '    Fix the network or Homebrew, then run dotgraft deps to retry\n' \
    '    修复网络或 Homebrew 后运行 dotgraft deps 重试\n' >&2
  exit 1
fi

dg_text '==> Dependencies are ready\n' '==> 依赖已就绪\n'
