#!/usr/bin/env bash
# ==============================================================================
# dotgraft —— 日常操作命令
# ==============================================================================
# 由 chezmoi 安装到 ~/.local/bin/dotgraft，提供安装之后的所有操作。
# 首次安装走 bootstrap.sh，不是这个脚本。
# ==============================================================================

APPLY_CANCELED=0

# 独立 source：不占用用户的 ~/.local/share/chezmoi，也不改 ~/.config/chezmoi。
# 可用环境变量覆盖，测试和特殊安装布局会用到。
DOTGRAFT_SOURCE="${DOTGRAFT_SOURCE:-${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi-dotgraft}"
DOTGRAFT_CONFIG="${DOTGRAFT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/dotgraft/chezmoi.toml}"

# 与 .chezmoi.toml.tmpl 的 promptChoice 列表保持一致。
DOTGRAFT_THEMES=(
  "Catppuccin Mocha"
  "Catppuccin Latte"
  "Catppuccin Frappe"
  "GitHub Dark"
  "GitHub Light Default"
  "TokyoNight"
)

step() { printf '\n==> %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
warn() { printf '    ! %s\n' "$*" >&2; }
die() {
  printf '\n错误: %s\n' "$*" >&2
  exit 1
}

confirm() {
  local reply
  printf '    %s [y/N] ' "$1"
  read -r reply
  [[ "$reply" == [yY] ]]
}

require_chezmoi() {
  command -v chezmoi > /dev/null 2>&1 || die "找不到 chezmoi。重新安装请跑 bootstrap.sh"
}

# 所有 chezmoi 调用都走这里，确保 source/config/destination 一致。
chezmoi_dg() {
  chezmoi \
    --source "$DOTGRAFT_SOURCE" \
    --config "$DOTGRAFT_CONFIG" \
    --destination "$HOME" \
    "$@"
}

# 判断当前 chezmoi source 是否真的是 Dotgraft。
#
# 这不是洁癖：uninstall / update 会写入或删除 source 里的内容，
# 如果用户把 dotgraft 命令指向了另一个 dotfiles 仓库，后果很严重。
# 新版本 source 有 .dotgraft-source 标记；旧版本用文件内容兜底。
is_dotgraft_source() {
  local src="$DOTGRAFT_SOURCE"
  [[ -n "$src" && -d "$src" ]] || return 1
  [[ -f "$src/.dotgraft-source" ]] && return 0
  [[ -f "$src/.chezmoi.toml.tmpl" ]] &&
    [[ -f "$src/dot_local/bin/executable_dotgraft" ]] &&
    grep -q 'Dotgraft' "$src/.chezmoi.toml.tmpl"
}

require_dotgraft_source() {
  require_chezmoi
  is_dotgraft_source || die "当前 Dotgraft 源目录不是有效仓库：${DOTGRAFT_SOURCE}。为安全起见，已停止。"
}

hash_file() {
  [[ -f "$1" ]] || return 0
  shasum -a 256 "$1" | awk '{print $1}'
}

source_commit() {
  git -C "$DOTGRAFT_SOURCE" log -1 --format='%h %s' 2> /dev/null || printf 'unknown'
}

default_glass() {
  local major
  major="$(sw_vers -productVersion 2> /dev/null | cut -d. -f1)"
  [[ "$major" =~ ^[0-9]+$ ]] || major=0
  if ((major >= 26)); then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

choose_theme() {
  local default="${1:-Catppuccin Mocha}" i choice marker
  printf '\n选择 Ghostty 主题：\n' >&2
  for i in "${!DOTGRAFT_THEMES[@]}"; do
    marker=""
    if [[ "${DOTGRAFT_THEMES[$i]}" == "$default" ]]; then
      marker="（默认）"
    fi
    printf '  %d) %s%s\n' "$((i + 1))" "${DOTGRAFT_THEMES[$i]}" "$marker" >&2
  done

  while true; do
    printf '输入编号 [1-%d]（回车使用默认）: ' "${#DOTGRAFT_THEMES[@]}" >&2
    if ! read -r choice; then
      printf '%s\n' "$default"
      return 0
    fi
    if [[ -z "$choice" ]]; then
      printf '%s\n' "$default"
      return 0
    fi
    if [[ "$choice" =~ ^[0-9]+$ ]] && ((10#$choice >= 1 && 10#$choice <= ${#DOTGRAFT_THEMES[@]})); then
      printf '%s\n' "${DOTGRAFT_THEMES[10#$choice - 1]}"
      return 0
    fi
    printf '  无效编号，请重试。\n' >&2
  done
}

choose_glass() {
  local default="${1:-false}" choice marker
  printf '\n毛玻璃效果：\n' >&2
  marker=""
  if [[ "$default" == "true" ]]; then
    marker="（默认）"
  fi
  printf '  1) 原生毛玻璃（macOS 26+）%s\n' "$marker" >&2
  marker=""
  if [[ "$default" == "false" ]]; then
    marker="（默认）"
  fi
  printf '  2) 数字模糊%s\n' "$marker" >&2

  while true; do
    printf '输入编号 [1-2]（回车使用默认）: ' >&2
    if ! read -r choice; then
      printf '%s\n' "$default"
      return 0
    fi
    case "$choice" in
      1)
        printf 'true\n'
        return 0
        ;;
      2)
        printf 'false\n'
        return 0
        ;;
      "")
        printf '%s\n' "$default"
        return 0
        ;;
      *) printf '  无效编号，请重试。\n' >&2 ;;
    esac
  done
}

current_theme() {
  local value
  value="$(chezmoi_dg execute-template '{{ .theme }}' 2> /dev/null || true)"
  printf '%s\n' "${value:-Catppuccin Mocha}"
}

current_glass() {
  local value
  value="$(chezmoi_dg execute-template '{{ if .glass }}true{{ else }}false{{ end }}' 2> /dev/null || true)"
  case "$value" in
    true | false) printf '%s\n' "$value" ;;
    *) default_glass ;;
  esac
}

theme_is_valid() {
  local theme="$1" candidate
  for candidate in "${DOTGRAFT_THEMES[@]}"; do
    if [[ "$candidate" == "$theme" ]]; then
      return 0
    fi
  done
  return 1
}

init_with_choices() {
  local theme glass
  theme="${DOTGRAFT_THEME:-}"
  if [[ -z "$theme" ]]; then
    theme="$(choose_theme "$(current_theme)")"
  fi
  theme_is_valid "$theme" || die "无效主题：$theme（可选：${DOTGRAFT_THEMES[*]}）"

  glass="${DOTGRAFT_GLASS:-}"
  if [[ -z "$glass" ]]; then
    glass="$(choose_glass "$(current_glass)")"
  fi
  case "$glass" in
    true | false) ;;
    *) die "无效 DOTGRAFT_GLASS：$glass（应为 true 或 false）" ;;
  esac

  chezmoi_dg init \
    --promptChoice "Ghostty 主题=$theme" \
    --promptBool "启用 macOS 原生毛玻璃效果？（需要 macOS 26 及以上）=$glass"
}

# uninstall 只允许删除这个白名单内的目标路径。
# 新增受管文件时记得同步这里，否则 tests/smoke.sh 会失败。
is_allowed_target() {
  local rel="${1#"${HOME%/}"/}"
  case "$rel" in
    .config/zsh/init.zsh | \
      .config/zsh/conf.d/10-history.zsh | \
      .config/zsh/conf.d/20-completion.zsh | \
      .config/zsh/conf.d/30-prompt.zsh | \
      .config/zsh/conf.d/40-tools.zsh | \
      .config/zsh/conf.d/50-functions.zsh | \
      .config/zsh/conf.d/60-plugins.zsh | \
      .config/zsh/conf.d/70-aliases.zsh | \
      .config/zsh/conf.d/80-dotgraft.zsh | \
      .config/zsh/conf.d/90-local.zsh | \
      .config/zsh/conf.d/99-highlighting.zsh | \
      .config/ghostty/config | \
      .config/starship.toml | \
      .local/bin/dotgraft | \
      .zshrc)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# 检查 ~/.zshrc 里的 dotgraft 区块是否成对。
# 只有开始标记、没有结束标记时，awk 会一路删到文件末尾；
# 与其静默丢数据，不如在卸载开始前直接拒绝。
zshrc_block_ok() {
  local file="$HOME/.zshrc" line state=0
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      '# >>> dotgraft >>>')
        [[ "$state" -eq 0 ]] || return 1
        state=1
        ;;
      '# <<< dotgraft <<<')
        [[ "$state" -eq 1 ]] || return 1
        state=0
        ;;
      *'>>> dotgraft >>>'* | *'<<< dotgraft <<<'*)
        # 行尾空格、CRLF 等变体：strip 脚本按精确行匹配，不能安全处理
        return 1
        ;;
    esac
  done < "$file"
  [[ "$state" -eq 0 ]]
}

resolve_symlink_target() {
  local file="$1" target dir base
  [[ -L "$file" ]] || return 1
  target="$(readlink "$file")" || return 1
  if [[ "$target" != /* ]]; then
    dir="$(cd "$(dirname "$file")" && pwd -P)" || return 1
    target="$dir/$target"
  fi
  dir="$(cd "$(dirname "$target")" && pwd -P)" || return 1
  base="$(basename "$target")"
  printf '%s/%s\n' "$dir" "$base"
}

backup_file() {
  local src="$1" dest_root="$2" rel target
  [[ -e "$src" || -L "$src" ]] || return 0
  rel="${src#"${HOME%/}"/}"
  mkdir -p "$dest_root/$(dirname "$rel")"

  if [[ -L "$src" ]]; then
    if ! target="$(readlink "$src")"; then
      warn "无法读取软链接：$src"
      return 1
    fi
    printf '%s\n' "$target" > "$dest_root/$rel.symlink" || {
      warn "无法备份软链接信息：$src"
      return 1
    }
    if [[ -f "$src" ]]; then
      cp -Lp "$src" "$dest_root/$rel" 2> /dev/null ||
        cp -L "$src" "$dest_root/$rel" || {
        warn "无法备份软链接内容：$src"
        return 1
      }
    fi
    return 0
  fi

  if ! cp -p "$src" "$dest_root/$rel" 2> /dev/null; then
    cp "$src" "$dest_root/$rel" || {
      warn "无法备份：$src"
      return 1
    }
  fi
}

# 只有当 source 是干净的 Dotgraft 克隆时才 purge。
# 有未提交改动、未推送提交、或 remote 不像 dotgraft 时一律保留，
# 避免把用户加在同一 source 里的私有 dotfiles 一起删掉。
can_purge_source() {
  local src ahead
  src="$DOTGRAFT_SOURCE"
  is_dotgraft_source || return 1
  git -C "$src" rev-parse --git-dir > /dev/null 2>&1 || return 1
  [[ -z "$(git -C "$src" status --porcelain 2> /dev/null)" ]] || return 1
  ahead="$(git -C "$src" rev-list --count '@{u}..HEAD' 2> /dev/null)" || return 1
  [[ "$ahead" == "0" ]] || return 1
  git -C "$src" remote get-url origin 2> /dev/null | grep -qi 'dotgraft' || return 1
}

# ==============================================================================
# status
# ==============================================================================
cmd_status() {
  require_dotgraft_source
  step "配置状态"
  note "源目录: $DOTGRAFT_SOURCE"
  note "配置:   $DOTGRAFT_CONFIG"
  note "版本:   $(source_commit)"
  note "chezmoi: $(chezmoi --version | head -1)"

  printf '\n'
  note "选配结果（存在 ${DOTGRAFT_CONFIG}，不进仓库）:"
  note "  工具:   $(chezmoi_dg execute-template '{{ if .tools }}{{ .tools | join " " }}{{ else }}（无）{{ end }}')"
  note "  主题:   $(chezmoi_dg execute-template '{{ .theme }}')"
  note "  毛玻璃: $(chezmoi_dg execute-template '{{ if .glass }}原生（macOS 26+）{{ else }}数字模糊{{ end }}')"

  printf '\n'
  note "与仓库的差异:"
  local st
  st="$(chezmoi_dg status || true)"
  if [[ -z "$st" ]]; then
    note "  无差异，已同步"
  else
    printf '%s\n' "$st" | sed 's/^/      /'
  fi
}

# ==============================================================================
# diff / apply
# ==============================================================================
# 文件级摘要。首次安装时所有目标都是新文件，完整 diff 会把
# starship.toml、dotgraft 等内容整份打印出来，没有可读性。
print_status_summary() {
  local status_out="$1" count
  count="$(printf '%s\n' "$status_out" | grep -c . || true)"
  note "待改动 $count 项："
  printf '%s\n' "$status_out" | sed 's/^/      /'
}

cmd_diff() {
  require_dotgraft_source
  local full=0 arg status_out
  for arg in "$@"; do
    case "$arg" in
      --full) full=1 ;;
      *)
        die "未知参数: $arg。用法: dotgraft diff [--full]"
        ;;
    esac
  done

  status_out="$(chezmoi_dg status --exclude=scripts 2> /dev/null || true)"
  if [[ -z "$status_out" ]]; then
    note "没有待应用的文件改动（依赖脚本不在此预览）。"
    return 0
  fi

  print_status_summary "$status_out"
  if [[ "$full" -eq 1 ]]; then
    printf '\n--- 完整 diff ---\n'
    chezmoi_dg diff --exclude=scripts
  else
    printf '\n'
    note "查看完整 diff: dotgraft diff --full"
  fi
}

cmd_apply() {
  require_dotgraft_source
  local status_out
  status_out="$(chezmoi_dg status --exclude=scripts 2> /dev/null || true)"
  if [[ -z "$status_out" ]]; then
    note "没有待应用的文件改动。"
    # 仍然跑一次 apply：文件没变不代表 run_onchange 脚本没变，
    # 例如只改了 Brewfile 时，依赖安装必须有机会执行。
    chezmoi_dg apply
    note "完成。"
    return 0
  fi

  print_status_summary "$status_out"
  printf '\n'
  confirm "应用这些改动？" || {
    printf '    已取消。\n'
    APPLY_CANCELED=1
    return 0
  }
  chezmoi_dg apply
  note "完成。开新终端窗口或 exec zsh 让 shell 配置生效。"
}

# ==============================================================================
# deps
# ==============================================================================
# run_onchange 只在脚本内容变化时执行，不能修“包被删了”或“上次装失败”。
# 这个命令无条件重跑同一份渲染后的安装脚本，作为收敛入口。
cmd_deps() {
  require_dotgraft_source
  local src tmpl
  src="$DOTGRAFT_SOURCE"
  tmpl="$src/run_onchange_install-packages.sh.tmpl"
  [[ -f "$tmpl" ]] || die "找不到依赖安装模板：$tmpl"

  step "安装 / 修复依赖"
  chezmoi_dg execute-template < "$tmpl" | sh
  note "依赖完成。"
}

# ==============================================================================
# update
# ==============================================================================
cmd_update() {
  require_dotgraft_source
  local src before after
  src="$DOTGRAFT_SOURCE"
  git -C "$src" rev-parse --git-dir > /dev/null 2>&1 || die "源目录不是 git 仓库，无法更新：$src"

  step "更新到上游最新"
  before="$(hash_file "$src/.chezmoi.toml.tmpl")"
  # 不用 chezmoi update：它会在模板缺新 data key 时直接 apply 失败。
  # 先 pull，再判断选配模板是否变化，变化就先重新 init。
  git -C "$src" pull --rebase
  after="$(hash_file "$src/.chezmoi.toml.tmpl")"

  if [[ "$before" != "$after" ]]; then
    step "选配模板有更新，重新询问配置"
    init_with_choices
  fi

  APPLY_CANCELED=0
  cmd_apply
  if [[ "$APPLY_CANCELED" -eq 1 ]]; then
    note "已取消，未更新依赖。"
    return 0
  fi

  cmd_deps
}

# ==============================================================================
# reconfigure
# ==============================================================================
cmd_reconfigure() {
  require_dotgraft_source
  step "重新选择组件"
  note "（主题/毛玻璃用编号菜单；CLI 工具由 chezmoi 勾选）"
  printf '\n'
  init_with_choices
  printf '\n'

  APPLY_CANCELED=0
  cmd_apply
  if [[ "$APPLY_CANCELED" -eq 1 ]]; then
    note "已取消，未更新依赖。"
    return 0
  fi

  cmd_deps
}

# ==============================================================================
# edit / cd / doctor
# ==============================================================================
cmd_edit() {
  require_dotgraft_source
  if [[ $# -eq 0 ]]; then
    note "用法: dotgraft edit <目标文件>，例如："
    note "  dotgraft edit ~/.config/ghostty/config"
    exit 1
  fi
  chezmoi_dg edit "$@"
}

cmd_cd() {
  require_dotgraft_source
  chezmoi_dg cd
}

DOCTOR_FAILED=0

doctor_row() {
  local state="$1" name="$2" message="$3"
  printf '  [%-4s] %-18s %s\n' "$state" "$name" "$message"
  if [[ "$state" == "fail" ]]; then
    DOCTOR_FAILED=1
  fi
  return 0
}

cmd_doctor() {
  require_chezmoi
  DOCTOR_FAILED=0
  step "Dotgraft 环境自检"

  local macos
  macos="$(sw_vers -productVersion 2> /dev/null || printf 'unknown')"
  doctor_row ok "macOS" "$macos"

  local shell_path="${SHELL:-unknown}"
  if [[ "$shell_path" == *zsh ]]; then
    doctor_row ok "Shell" "$shell_path"
  else
    doctor_row warn "Shell" "$shell_path（Dotgraft 假设 zsh）"
  fi

  if command -v brew > /dev/null 2>&1; then
    doctor_row ok "Homebrew" "$(brew --version 2> /dev/null | head -1) ($(brew --prefix 2> /dev/null))"
  else
    doctor_row fail "Homebrew" "未找到"
  fi

  if command -v chezmoi > /dev/null 2>&1; then
    doctor_row ok "chezmoi" "$(chezmoi --version 2> /dev/null | head -1)"
  else
    doctor_row fail "chezmoi" "未找到"
  fi

  if is_dotgraft_source; then
    doctor_row ok "Dotgraft source" "$DOTGRAFT_SOURCE"
  else
    doctor_row fail "Dotgraft source" "不是有效的 Dotgraft 仓库：$DOTGRAFT_SOURCE"
  fi

  if [[ -f "$DOTGRAFT_CONFIG" ]]; then
    doctor_row ok "Dotgraft config" "$DOTGRAFT_CONFIG"
  else
    doctor_row fail "Dotgraft config" "不存在：$DOTGRAFT_CONFIG"
  fi

  if [[ -f "$HOME/.zshrc" ]]; then
    if ! zshrc_block_ok; then
      doctor_row fail ".zshrc" "Dotgraft 区块不完整"
    elif grep -q '^# >>> dotgraft >>>$' "$HOME/.zshrc"; then
      doctor_row ok ".zshrc" "Dotgraft 区块存在"
    else
      doctor_row fail ".zshrc" "缺少 Dotgraft 区块"
    fi
  else
    doctor_row fail ".zshrc" "不存在"
  fi

  if [[ -f "$HOME/.config/zsh/init.zsh" ]]; then
    doctor_row ok "zsh config" "$HOME/.config/zsh/init.zsh"
  else
    doctor_row fail "zsh config" "缺少 init.zsh"
  fi

  if is_dotgraft_source && [[ -f "$DOTGRAFT_CONFIG" ]]; then
    local status_out
    status_out="$(chezmoi_dg status 2> /dev/null || true)"
    if [[ -z "$status_out" ]]; then
      doctor_row ok "managed files" "无差异"
    else
      doctor_row warn "managed files" "有未应用差异，运行 dotgraft diff 查看"
    fi

    local tools missing tool
    tools="$(chezmoi_dg execute-template '{{ range .tools }}{{ . }} {{ end }}' 2> /dev/null || true)"
    tools="${tools% }"
    if [[ -z "$tools" ]]; then
      doctor_row ok "selected tools" "未选择"
    else
      missing=""
      for tool in $tools; do
        command -v "$tool" > /dev/null 2>&1 || missing="$missing $tool"
      done
      if [[ -z "$missing" ]]; then
        doctor_row ok "selected tools" "$tools"
      else
        doctor_row warn "selected tools" "缺少:${missing}（运行 dotgraft deps）"
      fi
    fi
  else
    doctor_row warn "managed files" "跳过：source/config 不完整"
    doctor_row warn "selected tools" "跳过：source/config 不完整"
  fi

  if command -v starship > /dev/null 2>&1 && [[ -f "$HOME/.config/starship.toml" ]]; then
    doctor_row ok "Starship" "$(starship --version 2> /dev/null | head -1)"
  else
    doctor_row warn "Starship" "命令或 ~/.config/starship.toml 缺失"
  fi

  if command -v ghostty > /dev/null 2>&1; then
    doctor_row ok "Ghostty" "$(ghostty --version 2> /dev/null | head -1)"
  else
    doctor_row fail "Ghostty" "未找到"
  fi

  if [[ -f "$HOME/.config/ghostty/config" ]]; then
    doctor_row ok "Ghostty config" "$HOME/.config/ghostty/config"
  else
    doctor_row fail "Ghostty config" "不存在"
  fi

  local ghostty_override="$HOME/Library/Application Support/com.mitchellh.ghostty/config"
  if [[ -s "$ghostty_override" ]]; then
    doctor_row warn "Ghostty override" "存在，可能覆盖主题：$ghostty_override"
  else
    doctor_row ok "Ghostty override" "未发现"
  fi

  if [[ -n "$(find "$HOME/Library/Fonts" /Library/Fonts -maxdepth 1 -iname '*maple*cn*' -print -quit 2> /dev/null)" ]]; then
    doctor_row ok "Maple Mono CN" "已安装"
  else
    doctor_row warn "Maple Mono CN" "未找到，图标/中文可能回退"
  fi

  if git -C "$DOTGRAFT_SOURCE" rev-parse --git-dir > /dev/null 2>&1; then
    doctor_row ok "source commit" "$(source_commit)"
    if [[ -z "$(git -C "$DOTGRAFT_SOURCE" status --porcelain 2> /dev/null)" ]]; then
      doctor_row ok "source git" "clean"
    else
      doctor_row warn "source git" "有本地改动"
    fi
  fi

  printf '\n'
  if [[ "$DOCTOR_FAILED" -eq 0 ]]; then
    note "检查完成：没有发现阻塞性问题。"
  else
    warn "检查完成：存在需要修复的问题。"
  fi
  return "$DOCTOR_FAILED"
}

# ==============================================================================
# uninstall
# ==============================================================================
# 注意：chezmoi purge 只删自己的源码/配置/状态，不删目标文件。
# 所以这里必须自己清理 ~/.zshrc 区块和 ~/.config 下的文件。
# 不会卸载 Homebrew 包——那会连带删掉你其它项目依赖的东西。
# ==============================================================================
strip_zshrc_block() {
  local file="$HOME/.zshrc" target
  [[ -e "$file" || -L "$file" ]] || return 0

  # 如果 ~/.zshrc 是软链接，编辑它指向的真实文件，并保留链接本身。
  if [[ -L "$file" ]]; then
    if ! target="$(resolve_symlink_target "$file")"; then
      warn "无法解析 ~/.zshrc 软链接目标"
      return 1
    fi
    file="$target"
  fi

  [[ -f "$file" ]] || return 0
  grep -q '^# >>> dotgraft >>>$' "$file" || return 0

  local tmp
  tmp="$(mktemp)"
  # 跳过区块，并去掉文件末尾多余空行
  awk '
    /^# >>> dotgraft >>>$/ { skip = 1; next }
    /^# <<< dotgraft <<<$/ { skip = 0; next }
    !skip { lines[NR] = $0 }
    END {
      last = NR
      while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
      for (i = 1; i <= last; i++) print lines[i]
    }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

cmd_uninstall() {
  require_dotgraft_source
  step "卸载 Dotgraft"

  local src
  src="$DOTGRAFT_SOURCE"

  # 先做完全部只读检查，再动任何文件。
  zshrc_block_ok || die "$HOME/.zshrc 里的 dotgraft 区块不完整（有开始标记但没有结束标记，或反过来）。为避免误删，已停止。请先手动修复该区块。"

  if [[ -L "$HOME/.zshrc" ]]; then
    local zshrc_target
    zshrc_target="$(resolve_symlink_target "$HOME/.zshrc")" || die "无法解析 ${HOME}/.zshrc 软链接目标，已停止。"
    [[ -f "$zshrc_target" && -w "$zshrc_target" ]] || die "${HOME}/.zshrc 指向的目标不可写：$zshrc_target"
  fi

  local managed_list f unexpected=0
  if ! managed_list="$(chezmoi_dg managed --include=files --path-style=absolute 2> /dev/null)"; then
    die "无法读取 chezmoi 受管文件列表。请先运行 dotgraft doctor 检查环境。"
  fi

  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    if ! is_allowed_target "$f"; then
      warn "检测到非 Dotgraft 受管文件：$f"
      unexpected=1
    fi
  done <<< "$managed_list"

  if [[ "$unexpected" -ne 0 ]]; then
    die "当前 chezmoi 源目录里混有 Dotgraft 之外的受管文件。为避免误删，已停止。请先备份并手动处理上面列出的文件，或考虑换一个独立的 chezmoi source。"
  fi

  cat << 'WARN'
    将会：
      - 备份所有受管文件、~/.zshrc 和 chezmoi 配置
      - 删除 ~/.config/zsh/、~/.config/ghostty/config、~/.config/starship.toml
      - 删除 ~/.local/bin/dotgraft
      - 从 ~/.zshrc 移除 dotgraft 区块（其余内容保留）
      - 如果源目录是干净的 Dotgraft 克隆，清理 Dotgraft 自己的 chezmoi 状态

    不会：
      - 删除源目录里的私有文件/未提交改动（检测到就跳过清理）
      - 卸载任何 Homebrew 包（想删自己跑 brew uninstall）
      - 改动 ~/.zprofile、~/.zshenv
WARN

  printf '\n'
  confirm "确认卸载？" || {
    printf '    已取消。\n'
    exit 0
  }

  local stamp backup
  stamp="$(date +%Y%m%d_%H%M%S)"
  backup="$HOME/.config-backup/$stamp"
  mkdir -p "$backup/files"

  # 1. 备份所有受管文件（包含 90-local 和 .zshrc）
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    backup_file "$f" "$backup/files" || die "备份失败，已停止卸载：$f"
  done <<< "$managed_list"

  # 2. 备份 Dotgraft 独立的 chezmoi 选配答案
  if [[ -f "$DOTGRAFT_CONFIG" ]]; then
    cp -p "$DOTGRAFT_CONFIG" "$backup/chezmoi.toml" ||
      warn "无法备份 chezmoi.toml"
  fi

  # 3. 恢复 bootstrap 移开的 Ghostty 覆盖配置
  local ghostty_override="$HOME/Library/Application Support/com.mitchellh.ghostty/config"
  if [[ -e "$ghostty_override.before-dotgraft" ]]; then
    if [[ -e "$ghostty_override" ]]; then
      backup_file "$ghostty_override" "$backup/files" ||
        warn "无法备份当前 Ghostty 覆盖配置"
    fi
    mv "$ghostty_override.before-dotgraft" "$ghostty_override"
    note "已恢复 Ghostty 覆盖配置"
  fi

  # 4. 删除受管文件（.zshrc 单独处理，不能整份删）
  local removed=0
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    [[ "$f" == "${HOME%/}/.zshrc" ]] && continue
    [[ -e "$f" ]] || continue
    rm -f "$f" && removed=$((removed + 1))
  done <<< "$managed_list"
  note "已删除 $removed 个文件"

  # 5. 移除 ~/.zshrc 里的区块
  strip_zshrc_block
  note "已清理 ~/.zshrc 中的 dotgraft 区块"

  # 6. 清理空目录（用户自己的文件在里面时 rmdir 会失败，正合适）
  rmdir "$HOME/.config/zsh/conf.d" 2> /dev/null || true
  rmdir "$HOME/.config/zsh" 2> /dev/null || true
  rmdir "$HOME/.config/ghostty" 2> /dev/null || true
  rmdir "$HOME/.local/bin" 2> /dev/null || true

  # 7. 只在完全安全时清理 Dotgraft 自己的 source/config
  if can_purge_source; then
    chezmoi_dg purge --force
    rmdir "$(dirname "$DOTGRAFT_CONFIG")" 2> /dev/null || true
    note "已清理 Dotgraft 的 chezmoi 源码、配置和状态"
  else
    warn "源目录未清理：$src"
    note "它可能包含你的私有文件或未提交改动。确认无误后可手动执行："
    note "  dotgraft chezmoi purge --force"
  fi

  printf '\n'
  note "备份目录: $backup"
  note "开新终端窗口，你的 shell 会回到安装前的状态。"
}

# ==============================================================================
# chezmoi passthrough
# ==============================================================================
cmd_chezmoi() {
  require_chezmoi
  exec chezmoi \
    --source "$DOTGRAFT_SOURCE" \
    --config "$DOTGRAFT_CONFIG" \
    --destination "$HOME" \
    "$@"
}

# ==============================================================================
# help
# ==============================================================================
cmd_help() {
  cat << 'HELP'
dotgraft —— 终端配置管理

用法: dotgraft <命令>

命令:
  status        当前选配、文件差异、版本
  diff [--full] 预览改动摘要；--full 查看完整 diff
  apply         预览并应用改动
  update        拉取上游更新并应用（含依赖）
  deps          无条件安装/修复 Homebrew 依赖
  reconfigure   重新选择组件（工具 / 主题 / 毛玻璃）
  edit <文件>   编辑某个受管文件的仓库副本
  cd            进入 Dotgraft 的 chezmoi 源目录
  chezmoi ...   在 Dotgraft 的 source/config 上执行 chezmoi 子命令
  doctor        检查环境
  uninstall     卸载（备份受管文件，保留 Homebrew 包）

首次安装不走这里，用：
  bash <(curl -fsSL https://raw.githubusercontent.com/rokcso/dotgraft/main/bootstrap.sh)
HELP
}

# ==============================================================================
# 分发
# ==============================================================================
main() {
  local cmd="${1:-help}"
  [[ $# -gt 0 ]] && shift

  case "$cmd" in
    status) cmd_status ;;
    diff) cmd_diff "$@" ;;
    apply) cmd_apply ;;
    update) cmd_update ;;
    deps) cmd_deps ;;
    reconfigure) cmd_reconfigure ;;
    edit) cmd_edit "$@" ;;
    cd) cmd_cd ;;
    chezmoi) cmd_chezmoi "$@" ;;
    doctor) cmd_doctor ;;
    uninstall) cmd_uninstall ;;
    help | -h | --help) cmd_help ;;
    *)
      warn "未知命令: $cmd"
      printf '\n'
      cmd_help
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -euo pipefail
  main "$@"
fi
