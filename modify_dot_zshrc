{{- /* chezmoi:modify-template */ -}}
{{- /*
  This is a chezmoi modify script; its target is ~/.zshrc.
  Rule: read the current content from .chezmoi.stdin and write the result to stdout.
  chezmoi writes only when the output differs from the current file, so this is
  naturally idempotent.

  It does three things:
    1. Strip any existing dotgraft block (so upgrades replace instead of append)
    2. Remove trailing blank lines
    3. Append the current block at the end

  Nothing outside the block is touched.
*/ -}}
{{- $stdin := .chezmoi.stdin -}}
{{- $stripped := regexReplaceAll "(?s)# >>> dotgraft >>>.*?# <<< dotgraft <<<\n?" $stdin "" -}}
{{- $stripped = regexReplaceAll "\n+$" $stripped "" -}}
{{- $block := "# >>> dotgraft >>>\n# Managed by dotgraft; do not edit this block manually\n# Put machine-local configuration in ~/.config/zsh/conf.d/90-local.zsh\nsource \"$HOME/.config/zsh/init.zsh\"\n# <<< dotgraft <<<" -}}
{{- if $stripped -}}
{{ $stripped }}

{{ $block }}
{{- else -}}
{{ $block }}
{{- end -}}
