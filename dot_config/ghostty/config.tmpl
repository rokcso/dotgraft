# ==============================================================================
# Dotgraft - Ghostty
# ==============================================================================
# This file is managed by chezmoi. Edit it here, then:
#   dotgraft diff        # preview what would change
#   chezmoi apply        # sync to the home directory
#   Cmd + Shift + ,      # reload Ghostty configuration
#
# Theme and glass come from installation choices (change with dotgraft reconfigure)
#
# All available options: ghostty +show-config --default --docs
# All built-in themes: ghostty +list-themes --preview
# All available actions: ghostty +list-actions
# ==============================================================================

# ------------------------------------------------------------------------------
# Theme and colors
# ------------------------------------------------------------------------------
# Catppuccin Mocha: dark, low saturation, comfortable for long sessions.
# To follow the system light/dark mode, replace the line below with:
#   theme = dark:Dotgraft Ink,light:Dotgraft Paper
#
# Note: do not set background below; the theme already defines the ground color.
# A hand-written background overrides the theme palette, wasting the switch.
theme = {{ .theme }}

# ------------------------------------------------------------------------------
# Fonts
# ------------------------------------------------------------------------------
# Must be a Nerd Font variant, or icons and powerline separators will be missing.
# Use the CN variant: it includes Chinese glyphs, so Chinese does not fall back.
# If you installed the non-CN variant, use the family name "Maple Mono NF".
# Use ghostty +show-face with a mixed Chinese/ASCII string to confirm the font matches.
font-family = "Maple Mono NF CN"
font-size = 13

# macOS only: add a stroke for sharper text on Retina displays.
font-thicken = true

# Optional: line spacing. The percentage is added to the base value, not a target.
#adjust-cell-height = 10%

# ------------------------------------------------------------------------------
# Window: translucent glass
# ------------------------------------------------------------------------------
# Padding from content to window edge in points, scaled by screen DPI.
window-padding-x = 12
window-padding-y = 8
# Viewports rarely divide evenly by cell size; split the remainder across all sides.
window-padding-balance = true

# Opacity. 0.92 shows the wallpaper without interfering with reading code.
background-opacity = 0.92
{{ if .glass -}}
# Native macOS 26+ glass, which fits the system better than numeric blur.
background-blur = macos-glass-regular
{{- else -}}
# Numeric blur strength. It only applies when background-opacity is below 1.
# Higher values blur more; 20 is safe, while values above 30 may render badly.
background-blur = 20
{{- end }}

# native: the standard macOS title bar keeps tab information visible.
# tabs is a custom title bar that can hide tab information on some macOS/Ghostty combos;
# Use transparent for a more seamless look, or hidden to hide the title bar entirely.
macos-titlebar-style = native

# Preserve window state on exit: position, size, tabs, and splits restore next launch.
window-save-state = always

# ------------------------------------------------------------------------------
# Cursor
# ------------------------------------------------------------------------------
# bar | block | underline | block_hollow
cursor-style = bar
cursor-style-blink = true

# Note: shell integration forces the cursor back to a bar at the prompt.
# To keep this setting authoritative, also add:
#   shell-integration-features = no-cursor

# ------------------------------------------------------------------------------
# Interaction
# ------------------------------------------------------------------------------
mouse-hide-while-typing = true
confirm-close-surface = false

# Copy-on-select is already the macOS default (copy-on-select = true).

# ------------------------------------------------------------------------------
# Shell integration
# ------------------------------------------------------------------------------
# Provides prompt navigation, working-directory tracking, command boundaries, and more.
# Restoring splits/tabs to their previous directories also depends on it.
shell-integration = zsh

# ==============================================================================
# Optional enhancements below are off by default; uncomment when needed
# ==============================================================================

# Automatically increase contrast when foreground and background are too close.
#minimum-contrast = 1.1

# Send a system notification when a command finishes while the window is unfocused.
#notify-on-command-finish = unfocused

# Quick terminal: a temporary terminal from the screen edge, like Guake / iTerm2 hotkeys.
# Triggers cannot contain spaces; the equals sign is attached: trigger=action
#keybind = global:cmd+shift+space=toggle_quick_terminal
#quick-terminal-position = top
#quick-terminal-screen = mouse
