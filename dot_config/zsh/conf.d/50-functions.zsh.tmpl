{{- if has "yazi" .tools }}
# ------------------------------------------------------------------------------
# y - open yazi and stay in the directory you browsed on exit
# ------------------------------------------------------------------------------
# Plain yazi leaves the shell where it was; this wrapper turns exit into a cd.
#
# How: yazi supports --cwd-file; it writes the final directory there for us to read.
#
# Two details are intentional:
#   command cat    bypass the cat -> bat alias in 70-aliases.zsh.
#                  bat adds paging and formatting, which would corrupt this temp file read.
#   builtin cd     bypass any cd alias/function so the directory really changes.
if (( $+commands[yazi] )); then
  function y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)"

    yazi "$@" --cwd-file="$tmp"

    if cwd="$(command cat -- "$tmp" 2>/dev/null)" &&
       [[ -n "$cwd" ]] && [[ "$cwd" != "$PWD" ]]; then
      builtin cd -- "$cwd"
    fi

    rm -f -- "$tmp"
  }
fi
{{- end }}
