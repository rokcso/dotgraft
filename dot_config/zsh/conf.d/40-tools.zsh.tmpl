{{- if has "fzf" .tools }}
# ------------------------------------------------------------------------------
# fzf - fuzzy search
# ------------------------------------------------------------------------------
# Register two keybindings:
#   Ctrl+R  fuzzy-search command history
#   Ctrl+T  fuzzy-search files in the current directory
# It also supports `**<Tab>` completion, for example:
#   cd **<Tab>    open fzf to choose a subdirectory
#   kill **<Tab>  list all processes to choose from
#
# Note: --zsh is new in fzf 0.48; older versions error outright,
# so capture output first and eval only when non-empty, avoiding a dirty shell.
if (( $+commands[fzf] )); then
  _dotgraft_fzf_init="$(fzf --zsh 2>/dev/null)"
  if [[ -n "$_dotgraft_fzf_init" ]]; then
    eval "$_dotgraft_fzf_init"
  fi
  unset _dotgraft_fzf_init
fi
{{- end }}
{{- if has "zoxide" .tools }}

# ------------------------------------------------------------------------------
# zoxide - smart directory jumping
# ------------------------------------------------------------------------------
# Tracks directories you cd into, ranked by visit frequency and recency.
#   z foo        jump to the most frequent directory containing foo
#   z foo bar    match both foo and bar
#   zi foo       interactive mode: pick from matches with fzf
#
# WARNING: Do not write alias cd="z".
# zoxide tracks visits by hooking cd; aliasing cd to z stops it recording new directories,
# data stops updating. Use z directly; the habit forms quickly.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi
{{- end }}
