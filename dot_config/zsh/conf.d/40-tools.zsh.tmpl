{{- if has "fzf" .tools }}
# ------------------------------------------------------------------------------
# fzf —— 模糊搜索
# ------------------------------------------------------------------------------
# 注册两个快捷键：
#   Ctrl+R  模糊搜索历史命令
#   Ctrl+T  模糊搜索当前目录下的文件
# 另外支持 `**<Tab>` 补全，例如：
#   cd **<Tab>    弹出 fzf 让你选子目录
#   kill **<Tab>  列出所有进程让你选
#
# 注意：--zsh 是 fzf 0.48 之后的新接口，老版本会直接报错，
# 所以先取一次输出，拿得到才 eval，避免在不支持时把 shell 搞脏。
if (( $+commands[fzf] )); then
  _dotgraft_fzf_init="$(fzf --zsh 2>/dev/null)"
  if [[ -n "$_dotgraft_fzf_init" ]]; then
    eval "$_dotgraft_fzf_init"
  fi
  unset _dotgraft_fzf_init
fi
{{- end }}
{{- if has "zoxide" .tools }}

# ------------------------------------------------------------------------------
# zoxide —— 智能目录跳转
# ------------------------------------------------------------------------------
# 后台记录你 cd 过的目录，按访问频率和时间排序。
#   z foo        跳到路径里含 foo 的、最常去的目录
#   z foo bar    同时匹配 foo 和 bar
#   zi foo       交互模式，配合 fzf 从多个匹配里挑
#
# ⚠️ 不要写 alias cd="z"。
# zoxide 是靠 hook cd 来记录访问的，一旦把 cd 换成 z，它就记不到新目录，
# 数据会停止更新。直接用 z 就好，习惯形成得很快。
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi
{{- end }}
