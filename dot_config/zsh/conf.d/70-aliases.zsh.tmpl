{{- if has "eza" .tools }}
# ------------------------------------------------------------------------------
# eza - replace ls
# ------------------------------------------------------------------------------
# --icons                    mark file types with Nerd Font icons
# --group-directories-first  list directories before files
# --sort=name                sort by name instead of modification time
# --tree --level=2           show two tree levels to inspect project layout quickly
if (( $+commands[eza] )); then
  alias ls="eza --icons --group-directories-first"
  alias ll="eza -l --icons --sort=name"
  alias lt="eza --tree --icons --level=2"
fi
{{- end }}
{{- if has "bat" .tools }}

# ------------------------------------------------------------------------------
# bat - replace cat
# ------------------------------------------------------------------------------
# --paging=never  disable paging to match cat and avoid trapping output in less
# --style=plain   drop line numbers and grid decoration, keep syntax highlighting
#
# Note: this sends `cat` through bat. Use `command cat` in scripts that need raw content
# (the y function in 50-functions.zsh does exactly this).
if (( $+commands[bat] )); then
  alias cat="bat --paging=never --style=plain"
fi
{{- end }}
