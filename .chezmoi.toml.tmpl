{{- /*
  Per-machine questions, evaluated by chezmoi init.
  Answers are stored in Dotgraft's separate chezmoi configuration, not Git.
  Use dotgraft reconfigure to change selections.

  Prompt signatures: prompt <choices> [default]:
    promptBool        prompt [default]
    promptChoice      prompt choices [default]
    promptMultichoice prompt choices [default]
  Choices must be a list; provide one default argument.
*/ -}}

{{- /* DOTGRAFT_BILINGUAL_PROMPTS_V1: keep question text aligned with callers. */ -}}
{{- $language := output "sh" "-c" (printf "%s\ndotgraft_detect_language\n" (include "scripts/lib/language.sh")) | trim -}}
{{- $tools_question := "Which CLI tools should be enabled? (Space to select, Enter to confirm)" -}}
{{- $theme_question := "Ghostty theme" -}}
{{- $glass_question := "Enable native macOS glass? (Requires macOS 26 or later)" -}}
{{- if eq $language "zh" -}}
{{- $tools_question = "要启用哪些 CLI 工具？（空格勾选，回车确认）" -}}
{{- $theme_question = "Ghostty 主题" -}}
{{- $glass_question = "启用 macOS 原生毛玻璃效果？（需要 macOS 26 及以上）" -}}
{{- end -}}
{{- $tools := promptMultichoice
      $tools_question
      (list "fzf" "zoxide" "eza" "bat" "yazi")
      (list "fzf" "zoxide" "eza" "bat" "yazi") -}}

{{- /* Remove empty entries: chezmoi can return [""] for an empty selection,
       which would otherwise evaluate as true in downstream templates. */ -}}
{{- $clean := list -}}
{{- range $tools -}}
{{-   if ne . "" -}}
{{-     $clean = append $clean . -}}
{{-   end -}}
{{- end -}}

{{- /* Names must resolve to built-in Ghostty themes or installed theme files.
       The smoke test validates every theme in this list. */ -}}
{{- $theme := promptChoice
      $theme_question
      (list "Dotgraft Ink" "Dotgraft Paper" "Dotgraft Porcelain" "Catppuccin Mocha" "Catppuccin Latte" "Catppuccin Frappe" "GitHub Dark" "GitHub Light Default" "TokyoNight")
      "Dotgraft Ink" -}}

{{- /* Native glass requires macOS 26; use numeric blur on older systems. */ -}}
{{- $macos_major := index (splitList "." (output "sw_vers" "-productVersion")) 0 | atoi -}}
{{- $glass_default := ge $macos_major 26 -}}

{{- $glass := promptBool
      $glass_question
      $glass_default -}}

[data]
  tools = {{ $clean | toJson }}
  theme = {{ $theme | quote }}
  glass = {{ $glass }}
