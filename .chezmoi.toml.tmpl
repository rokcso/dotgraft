{{- /*
  chezmoi 的「每台机器问答」。只在 chezmoi init 时执行。
  答案写进 ~/.config/chezmoi/chezmoi.toml，不写进本仓库，
  所以你的个人选择不会被提交，也不会传到别人手上。

  想改选择：dotgraft reconfigure（或 chezmoi init 后再 chezmoi apply）

  prompt 函数签名统一是 prompt <choices> [default]：
    promptBool        prompt [default]
    promptChoice      prompt choices [default]
    promptMultichoice prompt choices [default]
  choices 必须是 (list ...)，default 必须只有一个值。
*/ -}}

{{-   $tools := promptMultichoice
      "要启用哪些 CLI 工具？（空格勾选，回车确认）"
      (list "fzf" "zoxide" "eza" "bat" "yazi")
      (list "fzf" "zoxide" "eza" "bat" "yazi") -}}

{{- /* 归一化选择结果。
       一个都不选时，chezmoi 可能给出 [""] 而不是 []，
       而 [""] 在模板里是真，会导致下游 `{{ if .tools }}` 误判。
       这里把空串滤掉。 */ -}}
{{- $clean := list -}}
{{- range $tools -}}
{{-   if ne . "" -}}
{{-     $clean = append $clean . -}}
{{-   end -}}
{{- end -}}

{{- /* 主题名必须是 Ghostty 能解析的名称：内置主题，或 ~/.config/ghostty/themes/
       下的自定义主题。Dotgraft Ink / Dotgraft Paper 由本仓库提供。
       可用 ghostty +list-themes 查看内置主题；tests/smoke.sh 会校验这里每一项。 */ -}}
{{- $theme := promptChoice
      "Ghostty 主题"
      (list "Dotgraft Ink" "Dotgraft Paper" "Catppuccin Mocha" "Catppuccin Latte" "Catppuccin Frappe" "GitHub Dark" "GitHub Light Default" "TokyoNight")
      "Dotgraft Ink" -}}

{{- /* 默认值跟系统版本走： macOS 26 起才支持 Ghostty 的原生毛玻璃。
       在更旧的 macOS 上默认 false，避免用户一路回车得到一个
       语义上不存在、甚至可能校验失败的配置。 */ -}}
{{- $macos_major := index (splitList "." (output "sw_vers" "-productVersion")) 0 | atoi -}}
{{- $glass_default := ge $macos_major 26 -}}

{{- $glass := promptBool
      "启用 macOS 原生毛玻璃效果？（需要 macOS 26 及以上）"
      $glass_default -}}

[data]
  tools = {{ $clean | toJson }}
  theme = {{ $theme | quote }}
  glass = {{ $glass }}
